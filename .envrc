# Only select tooling here: downloads and builds remain explicit commands.
watch_file lean-toolchain

elan_bin="${ELAN_HOME:-$HOME/.elan}/bin"
if [[ ! -x "$elan_bin/elan" || ! -x "$elan_bin/lean" || ! -x "$elan_bin/lake" ]]; then
  log_error "Install elan first: https://lean-lang.org/install/"
  return 1
fi

PATH_add "$elan_bin"
# The repository pin wins over any toolchain inherited from another shell.
export ELAN_TOOLCHAIN="$(cat lean-toolchain)"
